# stdlib/modules/db/db.lph
#
# db — database driver for Liphia.
#
# Supports SQLite (embedded, no installation required) and
# PostgreSQL (pure TCP wire protocol, no extra dependencies).
#
# Install:
#   liphia install db
#
# Usage:
#   import from "db"
#
# ── Optional per-driver helpers ───────────────────────────────────────────────
#
# The db_*/pg_* functions below are always available once "db" is installed,
# regardless of import. For extra convenience helpers specific to one driver
# (e.g. sqlite_table_exists, pg_table_exists), install and import the
# submodule explicitly:
#
#   liphia install db:sqlite
#   liphia install db:postgres
#
#   import { sqlite } from "db"
#   import { postgres } from "db"
#
#
# ── SQLite ────────────────────────────────────────────────────────────────────
#
# db_open(path: str) -> int
#   Opens a SQLite database file. Creates the file if it does not exist.
#   Returns a connection handle (int) used in all subsequent calls.
#
# db_open_memory() -> int
#   Opens an in-memory SQLite database. Data is lost when the handle is closed.
#   Useful for testing and temporary data.
#
# db_close(handle: int) -> bool
#   Closes and releases the connection. Returns true on success.
#
# db_exec(handle: int, sql: str) -> int
#   Executes a SQL statement that does not return rows (CREATE, INSERT, UPDATE,
#   DELETE, etc.). Returns the number of rows affected.
#
# db_query(handle: int, sql: str) -> list
#   Executes a SELECT and returns a flat list in the format:
#     ["col1", val1, "col2", val2, "col1", val1, ...]
#   Each pair of (column_name, value) represents one field from one row.
#   All rows are flattened into a single list.
#
# db_query_rows(handle: int, sql: str) -> list
#   Executes a SELECT and returns a list of rows.
#   Each row is itself a flat list: ["col1", val1, "col2", val2, ...]
#   Use this when you need to iterate over rows individually.
#
# db_last_id(handle: int) -> int
#   Returns the rowid of the last successful INSERT.
#
# db_begin(handle: int) -> bool
#   Starts a transaction (BEGIN).
#
# db_commit(handle: int) -> bool
#   Commits the current transaction.
#
# db_rollback(handle: int) -> bool
#   Rolls back the current transaction.
#
# db_error(handle: int) -> str
#   Returns the last error message for the connection.
#   Returns an empty string if there was no error.
#
# db_tables(handle: int) -> list
#   Returns a flat list of table names in the current database.
#
# db_columns(handle: int, table: str) -> list
#   Returns the PRAGMA table_info for a table as a flat list.
#   Each column is represented as: ["name", col_name, "type", col_type, ...]
#
# ── PostgreSQL ────────────────────────────────────────────────────────────────
#
# pg_connect(host: str, port: int, user: str, pass: str, db: str) -> int
#   Connects to a PostgreSQL server. Returns a connection handle.
#   Supports: trust authentication and cleartext password.
#   Does not support TLS or SCRAM — use a local/trusted connection for now.
#
# pg_exec(handle: int, sql: str) -> int
#   Executes a SQL statement (no result rows). Returns rows affected.
#
# pg_query(handle: int, sql: str) -> list
#   Executes a SELECT. Returns flat list ["col", val, "col", val, ...].
#
# pg_query_rows(handle: int, sql: str) -> list
#   Executes a SELECT. Returns a list of flat-row lists.
#
# pg_last_id(handle: int) -> int
#   Returns the last inserted id (use RETURNING id in your INSERT for best results).
#
# pg_begin(handle: int) -> bool
#   Starts a transaction.
#
# pg_commit(handle: int) -> bool
#   Commits the current transaction.
#
# pg_rollback(handle: int) -> bool
#   Rolls back the current transaction.
#
# pg_close(handle: int) -> bool
#   Closes the connection gracefully (sends Terminate message).
#
# pg_error(handle: int) -> str
#   Returns the last error message for the connection.
#
# ── Examples ──────────────────────────────────────────────────────────────────
#
# SQLite basic usage:
#
#   import from "db"
#
#   var conn: int = db_open("data.sqlite")
#
#   db_exec(conn, "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
#   db_exec(conn, "INSERT INTO users (name, age) VALUES ('Alice', 30)")
#   db_exec(conn, "INSERT INTO users (name, age) VALUES ('Bob', 25)")
#
#   var rows: list = db_query_rows(conn, "SELECT * FROM users")
#   print("rows:", len(rows))
#
#   var last: int = db_last_id(conn)
#   print("last id:", last)
#
#   db_close(conn)
#
# SQLite transaction:
#
#   import from "db"
#
#   var conn: int = db_open("data.sqlite")
#   db_begin(conn)
#   db_exec(conn, "INSERT INTO users (name, age) VALUES ('Carol', 28)")
#   db_exec(conn, "INSERT INTO users (name, age) VALUES ('Dave', 35)")
#   db_commit(conn)
#   db_close(conn)
#
# SQLite in-memory (for tests):
#
#   import from "db"
#
#   var conn: int = db_open_memory()
#   db_exec(conn, "CREATE TABLE t (x INTEGER)")
#   db_exec(conn, "INSERT INTO t VALUES (42)")
#   var rows: list = db_query(conn, "SELECT * FROM t")
#   print(rows)
#   db_close(conn)
#
# PostgreSQL basic usage:
#
#   import from "db"
#
#   var conn: int = pg_connect("127.0.0.1", 5432, "postgres", "secret", "mydb")
#   pg_exec(conn, "CREATE TABLE IF NOT EXISTS products (id SERIAL PRIMARY KEY, name TEXT, price FLOAT)")
#   pg_exec(conn, "INSERT INTO products (name, price) VALUES ('Widget', 9.99)")
#   var rows: list = pg_query_rows(conn, "SELECT * FROM products")
#   print("products:", len(rows))
#   pg_close(conn)
