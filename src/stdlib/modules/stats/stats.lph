# stdlib/lph/stats.lph
# Statistical functions for lists — all implemented natively in Rust (stdlib/native/src/stats.rs).

# ── Available functions ───────────────────────────────────────────────────────
#
# sum(data: list) -> float
#   Sum of all elements. List must contain int or float.
#
# mean(data: list) -> float
#   Arithmetic mean.
#
# min_list(data: list) -> float
#   Minimum value in list.
#
# max_list(data: list) -> float
#   Maximum value in list.
#
# median(data: list) -> float
#   Median value (middle element when sorted).
#   For even-length lists, returns average of two middle values.
#
# variance(data: list) -> float
#   Population variance.
#
# stdev(data: list) -> float
#   Population standard deviation.
#
# count(data: list) -> int
#   Number of elements. Same as len() for lists.
#
# ── Example ───────────────────────────────────────────────────────────────────
#
#   import "stats.lph"
#
#   var data: list = [4.0, 7.0, 13.0, 2.0, 1.0]
#   print("mean:   ", mean(data))
#   print("stdev:  ", stdev(data))
#   print("median: ", median(data))
