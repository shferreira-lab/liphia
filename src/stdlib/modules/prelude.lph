# stdlib/lph/prelude.lph
# Prelude: imports the core standard library modules.
# Use this for quick access to everything at once:
#
#   import from "prelude.lph"
#
# All functions are available directly after this import —
# no further qualification needed (e.g. just sqrt(x), not math.sqrt(x)).
# This is intentional: Liphia uses a flat function namespace for simplicity.


import from "math"
import from "stats"
import from "fs"
import from "net"
import from "http"
import from "ws"
import from "ai"
import from "json"
import from "db"
