# stdlib/lph/math.lph
# Mathematical functions — all implemented natively in Rust (stdlib/native/src/math.rs).

# ── Available functions ───────────────────────────────────────────────────────
#
# sqrt(x: int | float) -> float
#   Square root. x must be >= 0.
#
# pow(base: int | float, exp: int | float) -> float
#   base raised to the power of exp.
#
# abs(x: int | float) -> int | float
#   Absolute value. Returns same type as input.
#
# floor(x: int | float) -> int
#   Largest integer <= x.
#
# ceil(x: int | float) -> int
#   Smallest integer >= x.
#
# round(x: int | float) -> int
#   Rounds to nearest integer.
#
# min(a: int | float, b: int | float) -> int | float
# max(a: int | float, b: int | float) -> int | float
#
# pi() -> float     # 3.141592653589793
# e()  -> float     # 2.718281828459045
#
# log(x: int | float) -> float
#   Natural logarithm (base e). x must be > 0.
#
# log10(x: int | float) -> float
#   Base-10 logarithm. x must be > 0.
#
# sin(x: int | float) -> float   (radians)
# cos(x: int | float) -> float
# tan(x: int | float) -> float
#
# ── Example ───────────────────────────────────────────────────────────────────
#
#   import "math.lph"
#
#   var r: float = sqrt(16.0)          # 4.0
#   var area: float = pi() * pow(5.0, 2.0)
#   print("circle area: ", area)
