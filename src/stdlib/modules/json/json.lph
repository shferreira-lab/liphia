# stdlib/lph/json.lph
#
# JSON encode / decode — zero external dependencies.
#
# ── JSON Functions ───────────────────────────────────────────────────────────

# json_encode(value: any) -> str
#   Serializes any Liphia value to a JSON string.

# json_decode(text: str) -> any
#   Parses a JSON string.
#   Returns:
#     object  -> map
#     array   -> list
#     string  -> str
#     number  -> int | float
#     boolean -> bool
#     null    -> null

# json_get(text: str, key: str) -> str
#   Returns the string representation of the value associated with a key.

# json_has(text: str, key: str) -> bool
#   Returns true if the key exists in the JSON object.
