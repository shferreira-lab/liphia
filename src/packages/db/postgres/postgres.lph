# db/postgres/postgres.lph — PostgreSQL driver helpers.
# pg_* functions come from the db native library, loaded once the package
# is installed. This file adds convenience helpers on top of them.

fn pg_table_exists(conn: int, table: str) -> bool:
    var sql: str = "SELECT to_regclass('" + table + "') IS NOT NULL AS exists"
    var rows: list = pg_query_rows(conn, sql)
    return len(rows) > 0