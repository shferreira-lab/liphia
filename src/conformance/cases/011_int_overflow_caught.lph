# Integer overflow is a catchable runtime error, never a wrap-around.
var big = 9223372036854775807
try:
    print(big + 1)
catch e:
    print("caught:", e)
var small = 0 - big - 1
try:
    print(small / -1)
catch e:
    print("caught:", e)
try:
    print(0 - small)
catch e:
    print("caught:", e)
print("after")
