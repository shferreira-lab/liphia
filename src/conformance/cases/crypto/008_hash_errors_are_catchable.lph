# Bad arguments are runtime errors that try/catch can handle; execution
# continues afterwards.
try:
    crypto_sha256_hex("abc")
catch e:
    print("caught:", e)

try:
    crypto_sha1_hex("12zz")
catch e:
    print("caught:", e)

try:
    crypto_sha256(42)
catch e:
    print("caught:", e)

try:
    crypto_blake3("a", "b")
catch e:
    print("caught:", e)

try:
    crypto_sha512_hex("0x12")
catch e:
    print("caught:", e)

print("after")
