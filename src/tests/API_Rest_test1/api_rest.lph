# api_rest.lph
#
# REST API com SQLite — Liphia Engine 0.9.0
#
# Endpoints:
#   GET    /health        -> {"status":"ok","users":<count>}
#   GET    /users         -> list all users
#   GET    /users/1       -> user by id
#   POST   /users         -> create user  body: {"name":"Alice","email":"a@b.com"}
#   DELETE /users/1       -> remove user
#   *                     -> 404
#
# Run:
#   liphia api_rest.lph
#
# Testar (outra aba):
#   curl http://localhost:3000/health
#   curl http://localhost:3000/users
#   curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d "{\"name\":\"Alice\",\"email\":\"alice@test.com\"}"
#   curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d "{\"name\":\"Bob\",\"email\":\"bob@test.com\"}" 
#   curl http://localhost:3000/users/1
#   curl -X DELETE http://localhost:3000/users/1

import from "http"
import from "json"
import from "db"

const PORT    = 3000
const DB_PATH = "api_test.sqlite"

# ── banco de dados ────────────────────────────────────────────────────────────

var conn: int = db_open(DB_PATH)

var create_sql: str = "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT, created_at TEXT DEFAULT (datetime('now')))"
db_exec(conn, create_sql)

print("DB ready:", DB_PATH)

# ── helpers de resposta ───────────────────────────────────────────────────────

fn json_ok(body: str) -> void:
    http_respond_json(200, body)

fn json_created(body: str) -> void:
    http_respond_json(201, body)

fn json_not_found(msg: str) -> void:
    http_respond_json(404, "{\"error\": \"" + msg + "\"}")

fn json_bad(msg: str) -> void:
    http_respond_json(400, "{\"error\": \"" + msg + "\"}")

fn json_no_content() -> void:
    http_respond(204, "")

# ── converter row para JSON ───────────────────────────────────────────────────
#
# db_query_rows retorna lista de rows.
# Cada row e uma lista flat: ["id", "1", "name", "Alice", "email", "a@b.com", "created_at", "..."]
# Posicoes: 0=col_id 1=val_id 2=col_name 3=val_name 4=col_email 5=val_email 6=col_created 7=val_created

fn row_to_json(row: list) -> str:
    var id         = row[1]
    var name       = row[3]
    var email      = row[5]
    var created_at = row[7]
    var j = "{"
    j = j + "\"id\": " + to_str(id) + ", "
    j = j + "\"name\": \"" + to_str(name) + "\", "
    j = j + "\"email\": \"" + to_str(email) + "\", "
    j = j + "\"created_at\": \"" + to_str(created_at) + "\""
    j = j + "}"
    return j

fn rows_to_json(rows: list) -> str:
    var result = "["
    var total  = len(rows)
    var i      = 0
    while i < total:
        var row = rows[i]
        result = result + row_to_json(row)
        if i < total - 1:
            result = result + ","
        i = i + 1
    result = result + "]"
    return result

# ── handlers ──────────────────────────────────────────────────────────────────

fn handle_health() -> void:
    var count_rows = db_query_rows(conn, "SELECT COUNT(*) as total FROM users")
    var total = "0"
    if len(count_rows) > 0:
        var r = count_rows[0]
        total = to_str(r[1])
    var resp = "{\"status\": \"ok\", \"users\": " + total + "}"
    json_ok(resp)

fn handle_list_users() -> void:
    var rows: list = db_query_rows(conn, "SELECT id, name, email, created_at FROM users ORDER BY id")
    json_ok(rows_to_json(rows))

fn handle_get_user(path: str) -> void:
    var id: str    = replace(path, "/users/", "")
    var sql: str   = "SELECT id, name, email, created_at FROM users WHERE id = " + id
    var rows: list = db_query_rows(conn, sql)
    if len(rows) == 0:
        json_not_found("user not found")
    else:
        json_ok(row_to_json(rows[0]))

fn handle_create_user() -> void:
    var body: str = http_body()
    if body == "":
        json_bad("body required")
    else:
        var name:  str = json_get(body, "name")
        var email: str = json_get(body, "email")
        if name == "":
            json_bad("field name is required")
        else:
            var sql: str   = "INSERT INTO users (name, email) VALUES ('" + name + "', '" + email + "')"
            db_exec(conn, sql)
            var new_id: int = db_last_id(conn)
            var id_str: str = to_str(new_id)
            var sel: str    = "SELECT id, name, email, created_at FROM users WHERE id = " + id_str
            var rows: list  = db_query_rows(conn, sel)
            if len(rows) == 0:
                json_bad("insert failed")
            else:
                json_created(row_to_json(rows[0]))

fn handle_delete_user(path: str) -> void:
    var id: str     = replace(path, "/users/", "")
    var sel: str    = "SELECT id FROM users WHERE id = " + id
    var check: list = db_query_rows(conn, sel)
    if len(check) == 0:
        json_not_found("user not found")
    else:
        var del: str = "DELETE FROM users WHERE id = " + id
        db_exec(conn, del)
        json_no_content()

# ── router ────────────────────────────────────────────────────────────────────

fn route() -> void:
    var method: str = http_method()
    var path:   str = http_path()

    print("[" + method + "] " + path)

    if method == "GET" and path == "/health":
        handle_health()
    elif method == "GET" and path == "/users":
        handle_list_users()
    elif method == "GET" and starts_with(path, "/users/"):
        handle_get_user(path)
    elif method == "POST" and path == "/users":
        handle_create_user()
    elif method == "DELETE" and starts_with(path, "/users/"):
        handle_delete_user(path)
    else:
        json_not_found("endpoint not found")

# ── server loop ───────────────────────────────────────────────────────────────

async fn server_loop() -> void:
    while true:
        var got: bool = await http_accept()
        if got:
            route()

# ── entry point ───────────────────────────────────────────────────────────────

http_listen(PORT)
print("Liphia REST API running on port", PORT)
print("  GET    http://localhost:3000/health")
print("  GET    http://localhost:3000/users")
print("  POST   http://localhost:3000/users")
print("  DELETE http://localhost:3000/users/1")

spawn server_loop()
