import from "ai"

print("=== AI test 0.8 ===")
print("")

# ── ai primitives ─────────────────────────────────────────────────────────────
print("sigmoid(0) =", sigmoid(0.0))
print("relu(-3) =", relu(-3.0))
print("relu(5) =", relu(5.0))

var v1: list = [1.0, 2.0, 3.0]
var v2: list = [4.0, 5.0, 6.0]
print("dot =", dot(v1, v2))
print("norm =", norm(v1))

var probs: list = softmax([1.0, 2.0, 3.0])
print("softmax argmax =", argmax(probs))

print("")
print("=== AI tests complete ===")