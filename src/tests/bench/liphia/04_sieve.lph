# 04_sieve.lph
#
# Liphia benchmark workload. Prints one checksum line; the runner times the
# whole process externally and checks the checksum against the other languages.
#
# Sieve of Eratosthenes below 2,000,000: list append, index read/write.

fn count_primes(limit: int) -> int:
    var is_prime: list = []
    var i: int = 0
    while i < limit:
        append(is_prime, true)
        i = i + 1
    is_prime[0] = false
    is_prime[1] = false
    var p: int = 2
    while p * p < limit:
        if is_prime[p]:
            var m: int = p * p
            while m < limit:
                is_prime[m] = false
                m = m + p
        p = p + 1
    var count: int = 0
    i = 0
    while i < limit:
        if is_prime[i]:
            count = count + 1
        i = i + 1
    return count

print("sieve", count_primes(2000000))
