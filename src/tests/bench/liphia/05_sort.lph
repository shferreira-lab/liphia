# 05_sort.lph
#
# Liphia benchmark workload. Prints one checksum line; the runner times the
# whole process externally and checks the checksum against the other languages.
#
# Bubble sort of 2500 ints in reverse order: list reads/writes, comparisons.

fn bubble_sort_checksum(n: int) -> int:
    var items: list = []
    var i: int = 0
    while i < n:
        append(items, n - i)
        i = i + 1
    var end: int = n - 1
    while end > 0:
        var j: int = 0
        while j < end:
            if items[j] > items[j + 1]:
                var t: int = items[j]
                items[j] = items[j + 1]
                items[j + 1] = t
            j = j + 1
        end = end - 1
    var check: int = 0
    i = 0
    while i < n:
        check = check + items[i] * (i + 1)
        i = i + 1
    return check

print("sort", bubble_sort_checksum(2500))
