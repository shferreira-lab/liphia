# math_test1.lph
# Tests for all new functions in stdlib/lph/math.lph
# Run with: liphia math_test1.lph
#
# Expected output is shown after each print as a comment.
# Floating-point values may differ in the last 1-2 decimal digits.

import from "math"

print("═══════════════════════════════════════════")
print("  MATH TEST 1 — original functions")
print("═══════════════════════════════════════════")

print(sqrt(16.0))           # 4.0
print(sqrt(2.0))            # 1.4142135623730951
print(pow(2.0, 10.0))       # 1024.0
print(abs(-7))              # 7
print(abs(-3.14))           # 3.14
print(floor(3.9))           # 3
print(ceil(3.1))            # 4
print(round(3.5))           # 4
print(round(3.4))           # 3
print(min(3, 7))            # 3
print(max(3.5, 2.1))        # 3.5
print(pi())                 # 3.141592653589793
print(e())                  # 2.718281828459045
print(log(1.0))             # 0.0
print(log(e()))             # 1.0
print(log10(100.0))         # 2.0
print(sin(0.0))             # 0.0
print(cos(0.0))             # 1.0
print(tan(0.0))             # 0.0

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — inverse trigonometry")
print("═══════════════════════════════════════════")

# asin(1.0) = π/2 ≈ 1.5707963267948966
print(asin(1.0))            # 1.5707963267948966
print(asin(0.0))            # 0.0
print(asin(-1.0))           # -1.5707963267948966

# acos(1.0) = 0, acos(0.0) = π/2
print(acos(1.0))            # 0.0
print(acos(0.0))            # 1.5707963267948966

# atan(1.0) = π/4 ≈ 0.7853981633974483
print(atan(1.0))            # 0.7853981633974483
print(atan(0.0))            # 0.0

# atan2(y=1, x=1) = π/4
print(atan2(1.0, 1.0))      # 0.7853981633974483
# atan2(y=1, x=0) = π/2
print(atan2(1.0, 0.0))      # 1.5707963267948966
# atan2(y=-1, x=-1) = -3π/4
print(atan2(-1.0, -1.0))    # -2.356194490192345

# Round-trip: sin(asin(0.5)) ≈ 0.5
print(sin(asin(0.5)))       # 0.5
# Round-trip: asin(sin(π/6)) ≈ π/6 ≈ 0.5235987755982988
print(asin(sin(pi() / 6.0))) # 0.5235987755982988

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — hyperbolic functions")
print("═══════════════════════════════════════════")

print(sinh(0.0))            # 0.0
print(cosh(0.0))            # 1.0
print(tanh(0.0))            # 0.0

# sinh(1) ≈ 1.1752011936438014
print(sinh(1.0))            # 1.1752011936438014
# cosh(1) ≈ 1.5430806348152437
print(cosh(1.0))            # 1.5430806348152437
# tanh(1) ≈ 0.7615941559557649
print(tanh(1.0))            # 0.7615941559557649

# Identity: cosh²(x) - sinh²(x) = 1
# We check cosh(2)^2 - sinh(2)^2 ≈ 1
ch: float = cosh(2.0)
sh: float = sinh(2.0)
print(ch * ch - sh * sh)    # 1.0  (may show 0.9999999999999998)

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — exponential / logarithm")
print("═══════════════════════════════════════════")

# exp(0) = 1, exp(1) = e
print(exp(0.0))             # 1.0
print(exp(1.0))             # 2.718281828459045

# log(exp(3)) = 3
print(log(exp(3.0)))        # 3.0

# log2(1024) = 10
print(log2(1024.0))         # 10.0
print(log2(1.0))            # 0.0

# log_base(8, 2) = 3
print(log_base(8.0, 2.0))   # 3.0
# log_base(1000, 10) = 3
print(log_base(1000.0, 10.0)) # 3.0
# log_base(e(), e()) = 1
print(log_base(e(), e()))   # 1.0

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — number theory / combinatorics")
print("═══════════════════════════════════════════")

# factorial
print(factorial(0))         # 1
print(factorial(1))         # 1
print(factorial(5))         # 120
print(factorial(10))        # 3628800
print(factorial(20))        # 2432902008176640000

# gcd
print(gcd(48, 18))          # 6
print(gcd(100, 75))         # 25
print(gcd(0, 5))            # 5
print(gcd(-12, 8))          # 4   (works on negatives)

# lcm
print(lcm(4, 6))            # 12
print(lcm(7, 13))           # 91  (primes → product)
print(lcm(0, 9))            # 0

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — geometry / vector")
print("═══════════════════════════════════════════")

# hypot(3, 4) = 5 (3-4-5 triangle)
print(hypot(3.0, 4.0))      # 5.0
print(hypot(5.0, 12.0))     # 13.0

# angle conversion round-trip
r: float = deg_to_rad(180.0)
print(r)                    # 3.141592653589793
print(rad_to_deg(r))        # 180.0

print(deg_to_rad(90.0))     # 1.5707963267948966
print(rad_to_deg(pi() / 4.0)) # 45.0

# Using deg_to_rad with trig: sin(90°) = 1
print(sin(deg_to_rad(90.0)))  # 1.0
print(cos(deg_to_rad(60.0)))  # 0.5

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — utilities")
print("═══════════════════════════════════════════")

# sign
print(sign(-7))             # -1
print(sign(0))              # 0
print(sign(42))             # 1
print(sign(-3.14))          # -1
print(sign(0.0))            # 0

# clamp (int)
print(clamp(5, 0, 10))      # 5
print(clamp(-3, 0, 10))     # 0
print(clamp(15, 0, 10))     # 10

# clamp (float)
print(clamp(5.5, 0.0, 10.0))  # 5.5
print(clamp(-1.0, 0.0, 1.0))  # 0.0
print(clamp(2.0, 0.0, 1.0))   # 1.0

# is_nan / is_inf
print(is_nan(0.0))          # false
print(is_inf(0.0))          # false

# sqrt(-0.0) is fine (returns 0), but sqrt(-1) would error.
# We test is_nan on a known-good value.
print(is_nan(sqrt(0.0)))    # false

print("")
print("═══════════════════════════════════════════")
print("  MATH TEST 1 — edge / boundary cases")
print("═══════════════════════════════════════════")

# log / log2 / log10 approaching 0+
print(log(1.0))             # 0.0
print(log10(1.0))           # 0.0
print(log2(1.0))            # 0.0

# pow with fractional exponent
print(pow(27.0, 1.0/3.0))   # 3.0  (cube root)

# Large factorial at boundary
print(factorial(20))        # 2432902008176640000

# gcd of identical numbers
print(gcd(7, 7))            # 7

# hypot with zeros
print(hypot(0.0, 5.0))      # 5.0
print(hypot(5.0, 0.0))      # 5.0

print("")
print("All math tests done.")
