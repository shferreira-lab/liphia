# 09_ws_broadcast.lph — WebSocket server that relays every message to all
# connected clients.
#
#   liphia 09_ws_broadcast.lph
#   then connect with any WebSocket client to ws://localhost:8787
#
# ws_accept() returns 0 and ws_recv() returns "" when nothing is pending,
# so the loop polls. Core has no sleep yet, so this loop keeps a CPU core
# busy; fine for a demo.

ws_listen(8787)
print("listening on ws://localhost:8787")

while true:
    var client: int = ws_accept()
    if client != 0:
        ws_send_json(client, {"type": "welcome", "id": client})

    var clients: list = ws_clients()
    for i from 0 to len(clients):
        var msg: str = ws_recv(clients[i])
        if msg != "":
            ws_broadcast_json({"type": "message", "from": clients[i], "text": msg})
