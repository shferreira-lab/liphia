# Normalize line endings in the repository; checkouts follow the platform
* text=auto

# Shell scripts must keep LF everywhere or they fail on Linux/macOS
*.sh text eol=lf

# PowerShell and Inno Setup scripts keep CRLF
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary files are never converted
*.ico binary
*.png binary
*.dll binary